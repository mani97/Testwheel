# -------------------------
# Service Versions
# -------------------------
SERVICE_REGISTRY_VERSION=1.0.0
API_GATEWAY_VERSION=1.0.0
TEST_WHEEL_VERSION=1.0.0
TEST_SERVICE_VERSION=1.0.0
POSTGRES_VERSION=15
ZOOKEEPER_VERSION=7.5.0
KAFKA_VERSION=7.5.0
PGADMIN_VERSION=latest

# -------------------------
# Database Configuration
# -------------------------
POSTGRES_DB=internapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -------------------------
# Service Registry (Eureka)
# -------------------------
EUREKA_HOST=service-registry
EUREKA_PORT=8761
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://service-registry:8761/eureka/

# -------------------------
# API Gateway
# -------------------------
API_GATEWAY_HOST_PORT=28765
API_GATEWAY_PORT=8765

# -------------------------
# Microservices Ports
# -------------------------
TEST_SERVICE_HOST_PORT=9097
TEST_SERVICE_PORT=9097
TEST_WHEEL_HOST_PORT=9098
TEST_WHEEL_PORT=9098

# -------------------------
# Kafka Configuration
# -------------------------
KAFKA_HOST_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# -------------------------
# Security & JWT Secrets
# -------------------------
JWT_SECRET=YOUR_JWT_SECRET_KEY

# -------------------------
# AWS Credentials (Placeholders)
# -------------------------
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=YOUR_S3_BUCKET

# -------------------------
# External Services (Placeholders)
# -------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# -------------------------
# PgAdmin Config
# -------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/internapp
TEST_SERVICE_DATASOURCE_URL=jdbc:postgresql://postgres:5432/testservice
